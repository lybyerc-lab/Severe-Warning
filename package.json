{
  "name": "severe-weather-mobile",
  "version": "5.1.0",
  "buildLabel": "Three.js Production Slice",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "inventory:update": "node scripts/update-inventory.mjs",
    "inventory:check": "node scripts/check-inventory.mjs",
    "lint:hygiene": "node scripts/check-hygiene.mjs",
    "models:validate": "node tools/asset-pipeline/model-validator.mjs",
    "audio:generate": "node scripts/generate-storm-audio.mjs && node scripts/apply-recorded-storm-effects.mjs && node scripts/append-rampage-music.mjs",
    "modern:typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "modern:build": "vite build && vite build --config vite.prelude.config.ts",
    "build": "pnpm run inventory:check && pnpm run lint:hygiene && pnpm run audio:generate && pnpm run modern:typecheck && pnpm run modern:build && node scripts/build-web.mjs",
    "verify:v500": "node scripts/verify-v500-campaign.mjs",
    "verify:v510": "node scripts/verify-v510-production-slice.mjs",
    "verify:phase2": "node scripts/verify-modernization-phase2-clocks.mjs",
    "verify:phase3": "node scripts/verify-modernization-phase3-input-abilities.mjs",
    "verify:phase4": "node scripts/verify-modernization-phase4-scoring-campaign.mjs",
    "verify:phase5": "node scripts/verify-modernization-phase5-presentation-world.mjs",
    "verify:phase6": "node scripts/verify-modernization-phase6-ui.mjs",
    "verify:phase7": "node scripts/verify-modernization-phase7-audio-traffic.mjs",
    "verify:phase8": "node scripts/verify-modernization-phase8-engine.mjs",
    "verify:newspaper": "node scripts/verify-newspaper-opening.mjs",
    "verify:landmarks": "node scripts/verify-landmark-animations.mjs",
    "verify:shop": "node scripts/verify-shop-system.mjs",
    "verify:economy": "node scripts/verify-economy-tables.mjs",
    "verify:results": "node scripts/verify-results-elements.mjs",
    "verify:orientation": "node scripts/verify-orientation-lock.mjs",
    "verify:art": "node scripts/verify-app-art.mjs",
    "brand:render": "node tools/brand/render-app-art.mjs",
    "qa:v510": "node scripts/qa-v510-production-slice.mjs",
    "qa:phase2": "node scripts/qa-modernization-phase2-clocks.mjs",
    "qa:phase3": "node scripts/qa-modernization-phase3-input-abilities.mjs",
    "qa:phase4": "node scripts/qa-modernization-phase4-scoring-campaign.mjs",
    "qa:phase5": "node scripts/qa-modernization-phase5-presentation-world.mjs",
    "qa:phase5:visual": "node scripts/compare-phase5-visual-baseline.mjs",
    "qa:phase6": "node scripts/qa-modernization-phase6-ui.mjs",
    "qa:phase7": "node scripts/qa-modernization-phase7-audio-traffic.mjs",
    "qa:phase8": "node scripts/qa-modernization-phase8-engine.mjs",
    "cap:sync": "pnpm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:debug": "pnpm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "models:seethrough": "node scripts/check-model-see-through.mjs",
    "qa:occlusion": "node scripts/measure-scene-occlusion.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@types/node": "^26.2.0",
    "playwright": "1.55.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
