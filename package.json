{
  "name": "severe-weather-mobile",
  "version": "5.1.0",
  "buildLabel": "Three.js Production Slice",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "audio:generate": "node scripts/generate-storm-audio.mjs && node scripts/apply-recorded-storm-effects.mjs && node scripts/append-rampage-music.mjs",
    "modern:typecheck": "tsc --noEmit",
    "modern:build": "vite build",
    "build": "pnpm run audio:generate && pnpm run modern:typecheck && pnpm run modern:build && node scripts/build-web.mjs",
    "verify:v500": "node scripts/verify-v500-campaign.mjs",
    "verify:v510": "node scripts/verify-v510-production-slice.mjs",
    "verify:phase2": "node scripts/verify-modernization-phase2-clocks.mjs",
    "verify:phase3": "node scripts/verify-modernization-phase3-input-abilities.mjs",
    "verify:phase4": "node scripts/verify-modernization-phase4-scoring-campaign.mjs",
    "verify:phase5": "node scripts/verify-modernization-phase5-presentation-world.mjs",
    "qa:v510": "node scripts/qa-v510-production-slice.mjs",
    "qa:phase2": "node scripts/qa-modernization-phase2-clocks.mjs",
    "qa:phase3": "node scripts/qa-modernization-phase3-input-abilities.mjs",
    "qa:phase4": "node scripts/qa-modernization-phase4-scoring-campaign.mjs",
    "qa:phase5": "node scripts/qa-modernization-phase5-presentation-world.mjs",
    "qa:phase5:visual": "node scripts/compare-phase5-visual-baseline.mjs",
    "cap:sync": "pnpm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:debug": "pnpm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "node node_modules/@capacitor/cli/bin/capacitor open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "playwright": "1.55.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
