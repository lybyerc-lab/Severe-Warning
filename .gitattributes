* text=auto eol=lf

# Unity YAML and project metadata should remain text for readable diffs.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.asmdef text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Common binary asset formats.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.blend binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
